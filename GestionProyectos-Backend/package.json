{
  "name": "gestionproyectos-backend",
  "version": "0.1.0",
  "description": "Hexagonal architecture backend (Node + Express + Knex + SQL Server)",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src/",
    "db:test": "ts-node --transpile-only src/database/test-connection.ts",
    "db:wipe": "ts-node --transpile-only src/database/wipe.ts",
    "db:migrate": "node --require ts-node/register/transpile-only ./node_modules/knex/bin/cli.js migrate:latest --knexfile src/config/database.ts",
    "db:migrate:rollback": "node --require ts-node/register/transpile-only ./node_modules/knex/bin/cli.js migrate:rollback --knexfile src/config/database.ts",
    "db:migrate:status": "node --require ts-node/register/transpile-only ./node_modules/knex/bin/cli.js migrate:status --knexfile src/config/database.ts",
    "db:migrate:make": "node --require ts-node/register/transpile-only ./node_modules/knex/bin/cli.js migrate:make --knexfile src/config/database.ts -x ts",
    "db:seed": "node --require ts-node/register/transpile-only ./node_modules/knex/bin/cli.js seed:run --knexfile src/config/database.ts",
    "db:seed:make": "node --require ts-node/register/transpile-only ./node_modules/knex/bin/cli.js seed:make --knexfile src/config/database.ts -x ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "tedious": "^18.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.7.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
